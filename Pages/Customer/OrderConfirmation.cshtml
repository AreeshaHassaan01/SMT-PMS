@page
@model PMS.Pages.Customer.OrderConfirmationModel
@{
    ViewData["Title"] = "Order Confirmed";
    ViewData["BreadcrumbIcon"] = "fa-solid fa-circle-check";
    ViewData["BreadcrumbTitle"] = "Order Confirmation";
    Layout = "_CustomerLayout";
    ViewData["CartCount"] = Model.CartCount;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Success Banner -->
        <div class="bg-white rounded-3 shadow-sm p-4 p-md-5 text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-3"
                 style="width: 72px; height: 72px; font-size: 32px;">
                <i class="fa-solid fa-check"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">Thank You For Your Order!</h3>
            <p class="text-muted mb-3">Your order has been placed and is currently being processed.</p>
            <div class="badge bg-purple px-3 py-2 fs-6" style="background-color: var(--primary);">
                Order #@Model.Order?.Id
            </div>
        </div>

        @if (Model.Order != null)
        {
            <!-- Order Details Card -->
            <div class="bg-white rounded-3 shadow-sm p-4 mb-4">
                <h5 class="fw-bold mb-4 border-bottom pb-2">
                    <i class="fa-solid fa-file-invoice me-2 text-primary"></i> Order Details
                </h5>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="text-muted small">Order Date</div>
                        <div class="fw-semibold">@Model.Order.CreatedAt.ToLocalTime().ToString("f")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Status</div>
                        <span class="status-badge @Model.Order.StatusBadgeClass">
                            <i class="fa-solid fa-clock me-1"></i> @Model.Order.Status
                        </span>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Payment Method</div>
                        <div class="fw-semibold">
                            <i class="fa-solid fa-money-bill-wave me-1 text-success"></i> @Model.Order.PaymentMethod
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Shipping Address</div>
                        <div class="fw-semibold">
                            <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                            @(string.IsNullOrWhiteSpace(Model.Order.ShippingAddress) ? "Default Address" : Model.Order.ShippingAddress)
                        </div>
                    </div>
                </div>

                <!-- Items Table -->
                <h6 class="fw-bold mb-3 text-secondary">Items Ordered</h6>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th class="text-center">Price</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Order.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(item.ProductImageUrl ?? "/images/products/default-product.svg")"
                                                 style="width:40px;height:40px;object-fit:contain;background:#f8f7ff;border-radius:6px;padding:3px;"
                                                 alt="@item.ProductName"
                                                 onerror="this.src='/images/products/default-product.svg'">
                                            <span class="fw-semibold">@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td class="text-center">Rs. @item.UnitPrice.ToString("N0")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end fw-bold">Rs. @item.Subtotal.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-semibold">Shipping:</td>
                                <td class="text-end text-success fw-bold">Free</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-6">Grand Total:</td>
                                <td class="text-end fw-bold fs-5 text-primary">Rs. @Model.Order.TotalAmount.ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex flex-wrap gap-2 justify-content-between">
                <a asp-page="/Customer/Orders" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-list me-1"></i> View Order History
                </a>
                <a asp-page="/Customer/Dashboard" class="btn btn-primary">
                    <i class="fa-solid fa-store me-1"></i> Continue Shopping
                </a>
            </div>
        }
    </div>
</div>

