@page
@model PMS.Pages.Customer.CartModel
@{
    ViewData["Title"] = "My Cart";
    ViewData["BreadcrumbIcon"] = "fa-solid fa-cart-shopping";
    ViewData["BreadcrumbTitle"] = "My Cart";
    Layout = "_CustomerLayout";
    ViewData["CartCount"] = Model.CartCount;
}

<div class="row g-4">
    <!-- Cart Items -->
    <div class="col-lg-8">
        <div class="bg-white rounded-3 shadow-sm">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">
                    <i class="fa-solid fa-cart-shopping me-2 text-primary"></i>
                    Shopping Cart
                    <span class="badge bg-primary ms-2">@Model.CartItems.Count() items</span>
                </h5>
                @if (Model.CartItems.Any())
                {
                    <form method="post" asp-page-handler="ClearCart">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Clear all items from cart?')">
                            <i class="fa-solid fa-trash-can me-1"></i> Clear All
                        </button>
                    </form>
                }
            </div>

            @if (!Model.CartItems.Any())
            {
                <div class="p-5 text-center">
                    <i class="fa-solid fa-cart-shopping fa-3x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">Your cart is empty</h5>
                    <a asp-page="/Customer/Dashboard" class="btn btn-primary mt-2">
                        <i class="fa-solid fa-store me-1"></i> Start Shopping
                    </a>
                </div>
            }
            else
            {
                <div class="p-3">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex align-items-center gap-3 p-3 mb-2 rounded-3 border bg-light">
                            <img src="@(item.ProductImageUrl ?? "/images/products/default-product.svg")"
                                 class="cart-item-img" alt="@item.ProductName"
                                 onerror="this.src='/images/products/default-product.svg'">
                            <div class="flex-grow-1">
                                <div class="fw-bold" style="font-size:0.95rem;">@item.ProductName</div>
                                <div class="text-muted small">@item.CategoryName</div>
                                <div class="text-primary fw-bold">Rs. @item.UnitPrice.ToString("N0") each</div>
                            </div>
                            <!-- Update Quantity -->
                            <form method="post" asp-page-handler="UpdateQty" class="d-flex align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="qty-btn" onclick="adjustQty(this,-1)">
                                        <i class="fa-solid fa-minus" style="font-size:0.65rem;"></i>
                                    </button>
                                    <input type="number" name="quantity" value="@item.Quantity" min="1"
                                           class="form-control p-0 text-center"
                                           style="width:48px;height:32px;font-size:0.88rem;border-radius:6px;" />
                                    <button type="button" class="qty-btn" onclick="adjustQty(this,1)">
                                        <i class="fa-solid fa-plus" style="font-size:0.65rem;"></i>
                                    </button>
                                </div>
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-rotate-right"></i>
                                </button>
                            </form>
                            <!-- Subtotal -->
                            <div class="fw-bold text-dark text-end" style="min-width:90px;">
                                Rs. @item.Subtotal.ToString("N0")
                            </div>
                            <!-- Remove -->
                            <form method="post" asp-page-handler="Remove">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Order Summary -->
    <div class="col-lg-4">
        <div class="bg-white rounded-3 shadow-sm p-4 sticky-top" style="top:80px;">
            <h5 class="fw-bold mb-4">
                <i class="fa-solid fa-receipt me-2 text-primary"></i> Order Summary
            </h5>
            @foreach (var item in Model.CartItems)
            {
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">@item.ProductName x@item.Quantity</span>
                    <span class="fw-semibold">Rs. @item.Subtotal.ToString("N0")</span>
                </div>
            }
            <hr>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Subtotal</span>
                <span class="fw-semibold">Rs. @Model.Subtotal.ToString("N0")</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Delivery</span>
                <span class="text-success fw-semibold">Free</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-4">
                <span class="fw-bold fs-6">Total</span>
                <span class="fw-bold fs-5 text-primary">Rs. @Model.Subtotal.ToString("N0")</span>
            </div>
            @if (Model.CartItems.Any())
            {
                <a asp-page="/Customer/Checkout" class="btn btn-primary w-100 py-2 fw-bold">
                    <i class="fa-solid fa-credit-card me-2"></i> Proceed to Checkout
                </a>
            }
            <a asp-page="/Customer/Dashboard" class="btn btn-outline-secondary w-100 mt-2">
                <i class="fa-solid fa-arrow-left me-1"></i> Continue Shopping
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function adjustQty(btn, delta) {
    var row = btn.closest('form');
    var inp = row.querySelector('input[type="number"]');
    var val = parseInt(inp.value) || 1;
    val = Math.max(1, val + delta);
    inp.value = val;
}
</script>
}

