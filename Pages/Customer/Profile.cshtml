@page
@model PMS.Pages.Customer.ProfileModel
@{
    ViewData["Title"] = "My Profile";
    ViewData["BreadcrumbIcon"] = "fa-solid fa-user-circle";
    ViewData["BreadcrumbTitle"] = "Customer Profile & Address";
    Layout = "_CustomerLayout";
    ViewData["CartCount"] = Model.CartCount;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bg-white rounded-3 shadow-sm p-4 p-md-5">
            <!-- Header -->
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="user-avatar-circle bg-info d-flex align-items-center justify-content-center"
                     style="width:54px;height:54px;font-size:24px;border-radius:50%;color:#fff;">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">@(string.IsNullOrWhiteSpace(Model.Input.FullName) ? User.Identity?.Name : Model.Input.FullName)</h4>
                    <span class="badge bg-secondary text-white">
                        <i class="fa-solid fa-basket-shopping me-1"></i> Customer Account
                    </span>
                    <span class="text-muted small ms-2">@Model.Email</span>
                </div>
            </div>

            <form method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <!-- Personal Information -->
                <h5 class="fw-bold text-dark mb-3">
                    <i class="fa-solid fa-id-card me-2 text-primary"></i> Personal Details
                </h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Input.FullName" class="form-label fw-semibold small"></label>
                        <input asp-for="Input.FullName" class="form-control" placeholder="e.g. John Doe" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Phone" class="form-label fw-semibold small"></label>
                        <input asp-for="Input.Phone" class="form-control" placeholder="e.g. +92 300 1234567" />
                        <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                    </div>
                </div>

                <!-- House / Delivery Address -->
                <div class="border-top pt-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="fa-solid fa-house-chimney me-2 text-primary"></i> House &amp; Delivery Address
                        </h5>
                        <span class="text-muted small">Used for order deliveries</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Input.Address" class="form-label fw-semibold small">House / Street Address</label>
                            <input asp-for="Input.Address" class="form-control"
                                   placeholder="e.g. House # 12, Street 4, Sector F-7/2, Block B" />
                            <span asp-validation-for="Input.Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.City" class="form-label fw-semibold small"></label>
                            <input asp-for="Input.City" class="form-control" placeholder="e.g. Islamabad, Lahore, Karachi" />
                            <span asp-validation-for="Input.City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Province" class="form-label fw-semibold small">Province / State</label>
                            <input asp-for="Input.Province" class="form-control" placeholder="e.g. Federal, Punjab, Sindh, KPK" />
                            <span asp-validation-for="Input.Province" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.PostalCode" class="form-label fw-semibold small"></label>
                            <input asp-for="Input.PostalCode" class="form-control" placeholder="e.g. 44000" />
                            <span asp-validation-for="Input.PostalCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Country" class="form-label fw-semibold small"></label>
                            <input asp-for="Input.Country" class="form-control" placeholder="e.g. Pakistan" />
                            <span asp-validation-for="Input.Country" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Saved Address Preview -->
                @if (!string.IsNullOrWhiteSpace(Model.SavedAddressDisplay))
                {
                    <div class="mt-4 p-3 bg-light rounded-3 border">
                        <div class="fw-bold text-secondary small mb-1">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i> Current Delivery Address:
                        </div>
                        <div class="text-dark">@Model.SavedAddressDisplay</div>
                    </div>
                }

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-page="/Customer/Dashboard" class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Profile &amp; Address
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

