@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bag &amp; Clothing Store PMS</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Tech & Brand Banner -->
    <header class="pms-top-banner">
        <div class="brand-section">
            <div class="brand-logo-icon">
                <i class="fa-solid fa-bag-shopping"></i>
            </div>
            <div class="brand-titles">
                <h1>Bag &amp; Clothing Store</h1>
                <p>Product Management System (PMS)</p>
            </div>
        </div>

        <div class="tech-badges">
            <span class="tech-badge aspnet">
                <i class="fa-solid fa-shapes"></i> ASP.NET Core (Razor Pages)
            </span>
            <span class="tech-badge csharp">
                <i class="fa-brands fa-microsoft"></i> C#
            </span>
            <span class="tech-badge sqlserver">
                <i class="fa-solid fa-database"></i> SQL Server
            </span>
            <span class="tech-badge adonet">
                <i class="fa-solid fa-bolt"></i> ADO.NET
            </span>
        </div>
    </header>

    <!-- Main Workspace Layout -->
    <div class="pms-app-layout">
        <!-- Sidebar Navigation -->
        <aside class="pms-sidebar">
            <div class="sidebar-header">
                <i class="fa-solid fa-bag-shopping"></i>
                <span>Bag &amp; Clothing<br />Store</span>
            </div>

            <ul class="sidebar-menu">
                <li>
                    <a asp-page="/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                        <i class="fa-solid fa-house"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a asp-page="/Products/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Products") == true ? "active" : "")">
                        <i class="fa-solid fa-box-open"></i>
                        <span>Products</span>
                    </a>
                </li>
                <li>
                    <a asp-page="/Categories/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Categories") == true ? "active" : "")">
                        <i class="fa-solid fa-table-cells-large"></i>
                        <span>Categories</span>
                    </a>
                </li>
                <li>
                    <a asp-page="/About" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/About" ? "active" : "")">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>About</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a asp-page="/Account/Logout" onclick="return confirm('Are you sure you want to log out?');">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content View -->
        <main class="pms-main-content">
            <!-- Top Bar -->
            <div class="pms-top-bar">
                <div class="page-breadcrumb-title">
                    @if (ViewData["BreadcrumbIcon"] != null)
                    {
                        <i class="@ViewData["BreadcrumbIcon"]"></i>
                    }
                    <span>@(ViewData["BreadcrumbTitle"] ?? ViewData["Title"] ?? "Dashboard")</span>
                </div>

                <div class="user-nav-dropdown dropdown">
                    <a href="#" class="user-profile-btn dropdown-toggle" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="user-avatar-circle @(User.IsInRole("Customer") ? "bg-info" : "bg-primary")">
                            <i class="fa-solid @(User.IsInRole("Customer") ? "fa-user" : "fa-user-shield")"></i>
                        </span>
                        <span class="user-name-text">@(User.Identity?.IsAuthenticated == true ? (User.FindFirst("RoleDisplayName")?.Value ?? User.Identity.Name) : "Guest")</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuDropdown">
                        <li>
                            <div class="px-3 py-2 border-bottom">
                                <div class="fw-bold text-dark">@(User.Identity?.Name ?? "Store User")</div>
                                @if (User.IsInRole("Admin & Stock Manager") || User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-purple text-white mt-1" style="background-color: var(--primary);">
                                        <i class="fa-solid fa-crown me-1"></i> Admin &amp; Stock Manager
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white mt-1">
                                        <i class="fa-solid fa-basket-shopping me-1"></i> Customer Account
                                    </span>
                                }
                            </div>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-page="/About">
                                <i class="fa-solid fa-circle-question me-2 text-info"></i> Tech &amp; Architecture
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item py-2 text-danger" asp-page="/Account/Logout">
                                <i class="fa-solid fa-right-from-bracket me-2"></i> Log Out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Body Container -->
            <div class="content-body">
                <!-- Flash Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
                        <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
                        <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
