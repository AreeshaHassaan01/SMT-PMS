@page
@model PMS.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Delete Product";
    ViewData["BreadcrumbIcon"] = "fa-solid fa-trash-can";
    ViewData["BreadcrumbTitle"] = "🗑️ Delete Product";
}

<div class="delete-confirm-card shadow-sm">
    <div class="delete-alert-header">
        <span class="delete-alert-icon">!</span>
        <span>Are you sure?</span>
    </div>

    <p class="text-secondary fs-6 mb-3">You are about to delete this product:</p>

    <!-- Preview Card -->
    <div class="delete-item-preview">
        <img src="@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/products/default-product.svg" : Model.Product.ImageUrl)" 
             alt="@Model.Product.Name" 
             onerror="this.src='/images/products/default-product.svg';" />
        <div>
            <h5 class="fw-bold mb-1 text-dark">@Model.Product.Name</h5>
            <div class="text-muted fw-semibold">Rs. @Model.Product.Price.ToString("N0")</div>
            <small class="badge bg-secondary text-white mt-1">@(Model.Product.CategoryName ?? "Product")</small>
        </div>
    </div>

    <p class="text-danger small fw-semibold mb-4">
        <i class="fa-solid fa-circle-exclamation me-1"></i> This action cannot be undone.
    </p>

    <!-- Actions -->
    <form method="post" class="d-flex justify-content-center gap-3">
        <input type="hidden" asp-for="Product.Id" />
        <a asp-page="/Index" class="pms-btn pms-btn-secondary px-4">Cancel</a>
        <button type="submit" class="pms-btn pms-btn-danger px-4">
            <i class="fa-solid fa-trash-can me-1"></i> Delete
        </button>
    </form>
</div>

