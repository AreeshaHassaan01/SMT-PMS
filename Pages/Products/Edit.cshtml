@page
@model PMS.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
    ViewData["BreadcrumbIcon"] = "fa-solid fa-pencil";
    ViewData["BreadcrumbTitle"] = "✏️ Edit Product";
}

<div class="row justify-content-center">
    <div class="col-xl-11">
        <div class="pms-card">
            <div class="pms-card-header bg-white">
                <h2 class="pms-card-title">
                    <i class="fa-solid fa-pen-to-square text-primary"></i>
                    Edit Product
                </h2>
                <a asp-page="/Index" class="text-muted text-decoration-none">
                    <i class="fa-solid fa-xmark fs-5"></i>
                </a>
            </div>

            <div class="p-4">
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Product.Id" />
                    <input type="hidden" asp-for="Product.ImageUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 shadow-sm"></div>

                    <div class="row g-4">
                        <!-- Left Column: Product Image Preview & Change Image Button -->
                        <div class="col-lg-4 col-md-5 d-flex flex-column align-items-center justify-content-center border-end pe-lg-4">
                            <div class="image-preview-box shadow-sm mb-3" style="width: 100%; height: 260px; max-width: 280px; background: #ffffff;">
                                <img id="productImageDisplay" 
                                     src="@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/products/default-product.svg" : Model.Product.ImageUrl)" 
                                     alt="@Model.Product.Name" 
                                     onerror="this.src='/images/products/default-product.svg';" />
                            </div>

                            <input asp-for="ImageUpload" type="file" id="changeImageFileInput" class="d-none" accept="image/*" onchange="previewEditImage(this)" />
                            
                            <button type="button" class="pms-btn pms-btn-secondary w-75 justify-content-center" onclick="document.getElementById('changeImageFileInput').click();">
                                <i class="fa-solid fa-camera"></i> Change Image
                            </button>
                            <span asp-validation-for="ImageUpload" class="validation-error"></span>
                            <small class="text-muted mt-2 text-center">JPG, PNG, SVG or WebP</small>
                        </div>

                        <!-- Right Column: Product Fields -->
                        <div class="col-lg-8 col-md-7 ps-lg-4">
                            <!-- Row 1: Name & Category -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-7">
                                    <label asp-for="Product.Name" class="form-label">
                                        Product Name <span class="required">*</span>
                                    </label>
                                    <input asp-for="Product.Name" class="form-control" />
                                    <span asp-validation-for="Product.Name" class="validation-error"></span>
                                </div>

                                <div class="col-md-5">
                                    <label asp-for="Product.CategoryId" class="form-label">
                                        Category <span class="required">*</span>
                                    </label>
                                    <select asp-for="Product.CategoryId" asp-items="Model.CategoryList" class="form-control form-select">
                                    </select>
                                    <span asp-validation-for="Product.CategoryId" class="validation-error"></span>
                                </div>
                            </div>

                            <!-- Row 2: Price (PKR) & Stock Quantity -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Product.Price" class="form-label">
                                        Price (PKR) <span class="required">*</span>
                                    </label>
                                    <input asp-for="Product.Price" type="number" step="1" class="form-control" />
                                    <span asp-validation-for="Product.Price" class="validation-error"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Product.Stock" class="form-label">
                                        Stock Quantity <span class="required">*</span>
                                    </label>
                                    <input asp-for="Product.Stock" type="number" min="0" class="form-control" />
                                    <span asp-validation-for="Product.Stock" class="validation-error"></span>
                                </div>
                            </div>

                            <!-- Row 3: Description -->
                            <div class="mb-3">
                                <label asp-for="Product.Description" class="form-label">Description</label>
                                <textarea asp-for="Product.Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Product.Description" class="validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="form-actions mt-4">
                        <a asp-page="/Index" class="pms-btn pms-btn-secondary">Cancel</a>
                        <button type="submit" class="pms-btn pms-btn-primary">
                            <i class="fa-solid fa-check"></i> Update Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewEditImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('productImageDisplay').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}

