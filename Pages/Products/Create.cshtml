@page
@model PMS.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Add New Product";
    ViewData["BreadcrumbIcon"] = "fa-solid fa-plus";
    ViewData["BreadcrumbTitle"] = "+ Add New Product";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <div class="pms-card">
            <div class="pms-card-header bg-white">
                <h2 class="pms-card-title">
                    <i class="fa-solid fa-plus text-primary"></i>
                    Add New Product
                </h2>
                <a asp-page="/Index" class="text-muted text-decoration-none">
                    <i class="fa-solid fa-xmark fs-5"></i>
                </a>
            </div>

            <div class="p-4">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 shadow-sm"></div>

                    <!-- Row 1: Product Name & Category -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Product.Name" class="form-label">
                                Product Name <span class="required">*</span>
                            </label>
                            <input asp-for="Product.Name" class="form-control" placeholder="Enter product name" />
                            <span asp-validation-for="Product.Name" class="validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Product.CategoryId" class="form-label">
                                Category <span class="required">*</span>
                            </label>
                            <select asp-for="Product.CategoryId" asp-items="Model.CategoryList" class="form-control form-select">
                                <option value="">Select category</option>
                            </select>
                            <span asp-validation-for="Product.CategoryId" class="validation-error"></span>
                        </div>
                    </div>

                    <!-- Row 2: Price (PKR) & Stock Quantity -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Product.Price" class="form-label">
                                Price (PKR) <span class="required">*</span>
                            </label>
                            <input asp-for="Product.Price" type="number" step="1" class="form-control" placeholder="Enter price (e.g. 1999)" />
                            <span asp-validation-for="Product.Price" class="validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Product.Stock" class="form-label">
                                Stock Quantity <span class="required">*</span>
                            </label>
                            <input asp-for="Product.Stock" type="number" min="0" class="form-control" placeholder="Enter stock quantity" />
                            <span asp-validation-for="Product.Stock" class="validation-error"></span>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Product.Description" class="form-label">Description</label>
                        <textarea asp-for="Product.Description" class="form-control" rows="4" placeholder="Enter product description..."></textarea>
                        <span asp-validation-for="Product.Description" class="validation-error"></span>
                    </div>

                    <!-- Product Image -->
                    <div class="mb-4">
                        <label class="form-label">Product Image <small class="text-muted fw-normal">(Optional)</small></label>
                        <div class="d-flex align-items-center gap-3">
                            <input asp-for="ImageUpload" type="file" class="form-control" accept="image/*" id="imageInput" onchange="previewSelectedImage(this)" />
                        </div>
                        <span asp-validation-for="ImageUpload" class="validation-error"></span>

                        <!-- Live Preview Box -->
                        <div class="mt-3 d-none" id="previewContainer">
                            <div class="fw-semibold small text-muted mb-2">Image Preview:</div>
                            <div class="image-preview-box">
                                <img id="imagePreview" src="/images/products/default-product.svg" alt="Preview" />
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="form-actions">
                        <a asp-page="/Index" class="pms-btn pms-btn-secondary">Cancel</a>
                        <button type="submit" class="pms-btn pms-btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Save Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewSelectedImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('previewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}

