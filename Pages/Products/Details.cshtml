@page
@model PMS.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Product Details";
    ViewData["BreadcrumbIcon"] = "fa-solid fa-eye";
    ViewData["BreadcrumbTitle"] = "👁️ Product Details";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="pms-card">
            <div class="pms-card-header bg-white">
                <h2 class="pms-card-title">
                    <i class="fa-solid fa-circle-info text-primary"></i>
                    Product Details
                </h2>
                <div class="d-flex gap-2">
                    <a asp-page="/Products/Edit" asp-route-id="@Model.Product.Id" class="pms-btn pms-btn-secondary btn-sm">
                        <i class="fa-solid fa-pencil"></i> Edit Product
                    </a>
                </div>
            </div>

            <div class="p-4 p-md-5">
                <div class="row g-5 align-items-center">
                    <!-- Left: Large Product Image -->
                    <div class="col-md-5 text-center">
                        <div class="p-4 bg-white rounded-4 border shadow-sm d-flex align-items-center justify-content-center" style="height: 320px;">
                            <img src="@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/products/default-product.svg" : Model.Product.ImageUrl)" 
                                 alt="@Model.Product.Name" 
                                 class="img-fluid" 
                                 style="max-height: 270px; object-fit: contain;" 
                                 onerror="this.src='/images/products/default-product.svg';" />
                        </div>
                    </div>

                    <!-- Right: Product Specifications -->
                    <div class="col-md-7">
                        <div class="mb-4">
                            <span class="category-pill mb-2">@(Model.Product.CategoryName ?? "General")</span>
                            <h2 class="fw-bold text-dark mt-2 mb-3">@Model.Product.Name</h2>
                        </div>

                        <div class="d-flex flex-column gap-3 mb-4 fs-6">
                            <div class="d-flex align-items-center">
                                <span class="fw-bold text-muted" style="width: 130px;">Name:</span>
                                <span class="fw-semibold text-dark">@Model.Product.Name</span>
                            </div>

                            <div class="d-flex align-items-center">
                                <span class="fw-bold text-muted" style="width: 130px;">Category:</span>
                                <span class="fw-semibold text-dark">@(Model.Product.CategoryName ?? "Bags")</span>
                            </div>

                            <div class="d-flex align-items-center">
                                <span class="fw-bold text-muted" style="width: 130px;">Price:</span>
                                <span class="fw-bold text-primary fs-5">Rs. @Model.Product.Price.ToString("N0")</span>
                            </div>

                            <div class="d-flex align-items-center">
                                <span class="fw-bold text-muted" style="width: 130px;">Stock:</span>
                                <div>
                                    @if (Model.Product.Stock == 0)
                                    {
                                        <span class="badge bg-danger">Out of Stock (0)</span>
                                    }
                                    else if (Model.Product.Stock <= 5)
                                    {
                                        <span class="badge bg-warning text-dark">@Model.Product.Stock (Low Stock)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@Model.Product.Stock In Stock</span>
                                    }
                                </div>
                            </div>

                            <div class="d-flex">
                                <span class="fw-bold text-muted" style="width: 130px; flex-shrink: 0;">Description:</span>
                                <span class="text-secondary">@(string.IsNullOrWhiteSpace(Model.Product.Description) ? "No description provided." : Model.Product.Description)</span>
                            </div>
                        </div>

                        <!-- Back to List Button -->
                        <div class="pt-3 border-top">
                            <a asp-page="/Index" class="pms-btn pms-btn-primary">
                                <i class="fa-solid fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

