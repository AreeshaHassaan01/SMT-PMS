@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["BreadcrumbIcon"] = "fa-solid fa-house";
    ViewData["BreadcrumbTitle"] = "Dashboard";
}

<!-- Stat Metric Cards -->
<div class="stats-grid">
    <!-- Total Products -->
    <div class="stat-card">
        <div class="stat-icon-wrap purple">
            <i class="fa-solid fa-box-open"></i>
        </div>
        <div class="stat-info">
            <span class="stat-label">Total Products</span>
            <span class="stat-number">@Model.Stats.TotalProducts</span>
        </div>
    </div>

    <!-- Total Categories -->
    <div class="stat-card">
        <div class="stat-icon-wrap green">
            <i class="fa-solid fa-bag-shopping"></i>
        </div>
        <div class="stat-info">
            <span class="stat-label">Total Categories</span>
            <span class="stat-number">@Model.Stats.TotalCategories</span>
        </div>
    </div>

    <!-- In Stock -->
    <div class="stat-card">
        <div class="stat-icon-wrap orange">
            <i class="fa-solid fa-boxes-stacked"></i>
        </div>
        <div class="stat-info">
            <span class="stat-label">In Stock</span>
            <span class="stat-number">@Model.Stats.InStock</span>
        </div>
    </div>

    <!-- Low Stock -->
    <div class="stat-card">
        <div class="stat-icon-wrap red">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="stat-info">
            <span class="stat-label">Low Stock</span>
            <span class="stat-number">@Model.Stats.LowStock</span>
        </div>
    </div>
</div>

<!-- Products Table Card -->
<div class="pms-card">
    <div class="pms-card-header">
        <div class="d-flex align-items-center gap-3">
            <h2 class="pms-card-title">
                <i class="fa-solid fa-boxes-packing text-primary"></i>
                Products
            </h2>
            <span class="badge bg-light text-dark border">@Model.Products.Count() items</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (User.IsInRole("Customer"))
            {
                <span class="badge bg-light text-muted border py-2 px-3" title="Log in with SECRET-CODE: ANYONEUSEIT to manage stock">
                    <i class="fa-solid fa-lock me-1 text-warning"></i> Customer Mode (Viewing Only)
                </span>
            }
            else
            {
                <a asp-page="/Products/Create" class="pms-btn pms-btn-primary">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add Product</span>
                </a>
            }
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="p-3 bg-light border-bottom">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" asp-for="SearchTerm" class="form-control border-start-0" placeholder="Search by name or description..." />
                </div>
            </div>
            <div class="col-md-4">
                <select asp-for="CategoryId" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id">@cat.Name (@cat.ProductCount)</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="pms-btn pms-btn-primary flex-grow-1 justify-content-center">
                    <i class="fa-solid fa-filter"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.CategoryId.HasValue)
                {
                    <a asp-page="/Index" class="pms-btn pms-btn-secondary" title="Clear Filters">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Products Table -->
    <div class="table-responsive">
        <table class="pms-table">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th style="width: 80px;">Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price (PKR)</th>
                    <th>Stock</th>
                    <th style="width: 140px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Products.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-box-open fs-1 d-block mb-3 text-secondary opacity-50"></i>
                            <div class="fw-semibold">No products found</div>
                            <small>Try adjusting your search criteria or add a new product.</small>
                            <div class="mt-3">
                                <a asp-page="/Products/Create" class="pms-btn pms-btn-primary btn-sm">
                                    <i class="fa-solid fa-plus me-1"></i> Add First Product
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            <td class="text-muted fw-bold">@index</td>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/products/default-product.svg" : item.ImageUrl)" 
                                     alt="@item.Name" 
                                     class="product-thumb" 
                                     onerror="this.src='/images/products/default-product.svg';" />
                            </td>
                            <td>
                                <a asp-page="/Products/Details" asp-route-id="@item.Id" class="text-decoration-none fw-bold text-dark hover-primary">
                                    @item.Name
                                </a>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 280px;">
                                        @item.Description
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="category-pill">@(item.CategoryName ?? "General")</span>
                            </td>
                            <td class="fw-bold">
                                @item.Price.ToString("N0")
                            </td>
                            <td>
                                @if (item.Stock == 0)
                                {
                                    <span class="stock-badge stock-out">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> Out of Stock
                                    </span>
                                }
                                else if (item.Stock <= 5)
                                {
                                    <span class="stock-badge stock-low">
                                        @item.Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="stock-badge stock-in">
                                        @item.Stock
                                    </span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="action-buttons justify-content-end">
                                    <a asp-page="/Products/Details" asp-route-id="@item.Id" class="btn-action-view" title="View Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    @if (!User.IsInRole("Customer"))
                                    {
                                        <a asp-page="/Products/Edit" asp-route-id="@item.Id" class="btn-action-edit" title="Edit Product">
                                            <i class="fa-solid fa-pencil"></i>
                                        </a>
                                        <a asp-page="/Products/Delete" asp-route-id="@item.Id" class="btn-action-delete" title="Delete Product">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
